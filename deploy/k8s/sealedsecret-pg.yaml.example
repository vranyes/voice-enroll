# OPERATOR TEMPLATE — the cnpg bootstrap secret. Sealed the same way as
# sealedsecret-app.yaml.example (username: enroll, dbname: voiceenroll).
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: voice-enroll-pg-credentials
  namespace: voice-enroll
spec:
  encryptedData:
    username: REPLACE_ME_SEALED
    password: REPLACE_ME_SEALED
  template:
    metadata:
      name: voice-enroll-pg-credentials
      namespace: voice-enroll
