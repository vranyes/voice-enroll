# OPERATOR TEMPLATE — NOT APPLIED. Do not add to kustomization.yaml.
#
# Generate real values, then seal with:
#   kubectl create secret generic voice-enroll-secrets -n voice-enroll \
#     --from-literal=DATABASE_URL='postgresql://enroll:<pw>@voice-enroll-pg-rw.voice-enroll.svc:5432/voiceenroll?sslmode=verify-ca&sslrootcert=/run/secrets/pg-ca.crt' \
#     --from-literal=ENROLL_DEK_B64="$(head -c32 /dev/urandom | base64)" \
#     --from-literal=ENROLL_SESSION_SECRET_B64="$(head -c32 /dev/urandom | base64)" \
#     --from-literal=RESOLVE_EDGE_SECRET="$(head -c32 /dev/urandom | base64)" \
#     --from-literal=RESOLVE_TASKMASTER_SECRET="$(head -c32 /dev/urandom | base64)" \
#     --from-literal=KANIDM_CLIENT_SECRET='<from KanidmOAuth2Client secret>' \
#     --from-literal=TELNYX_API_KEY='<telnyx portal>' \
#     --from-literal=TELNYX_SENDER_NUMBER='<E.164 sender DID>' \
#     --dry-run=client -o yaml | kubeseal -o yaml > sealedsecret-app.yaml
---
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: voice-enroll-secrets
  namespace: voice-enroll
spec:
  encryptedData:
    DATABASE_URL: REPLACE_ME_SEALED
    ENROLL_DEK_B64: REPLACE_ME_SEALED
    ENROLL_SESSION_SECRET_B64: REPLACE_ME_SEALED
    RESOLVE_EDGE_SECRET: REPLACE_ME_SEALED
    RESOLVE_TASKMASTER_SECRET: REPLACE_ME_SEALED
    KANIDM_CLIENT_SECRET: REPLACE_ME_SEALED
    TELNYX_API_KEY: REPLACE_ME_SEALED
    TELNYX_SENDER_NUMBER: REPLACE_ME_SEALED
  template:
    metadata:
      name: voice-enroll-secrets
      namespace: voice-enroll
